#: ../../source/concepts/station-keeping.md 430d1c0cc8944810a5d004b864821493
msgid "45 km"
msgstr ""

#: ../../source/concepts/station-keeping.md f46dabdb566c4c13811787a40e962e34
msgid "30 天"
msgstr ""


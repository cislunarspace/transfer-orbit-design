msgid "后果"
msgstr ""

#: ../../adr/0008-output-as-persistence.md:42 c3ae735c22a447c1b682991c76c2fade
msgid "正面"
msgstr ""

#: ../../adr/0008-output-as-persistence.md:44 cfecece3960147988e9e126f6c8dcb41
msgid "不需要实现项目文件读写"
msgstr ""

#: ../../adr/0008-output-as-persistence.md:45 bdb31cc4447944e99c7427a0f4f8e950

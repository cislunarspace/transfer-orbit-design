msgstr ""

#: ../../adr/0012-defer-gil-and-facade-to-upstream.md:45
#: 3f694681c1864a81af71ee197f4ea02d
msgid "上游修好后一次性解决卡顿 + 接口边界"
msgstr ""

#: ../../adr/0012-defer-gil-and-facade-to-upstream.md:46
#: 7f5724474161491e95e9372712af6b34
msgid "不引入子进程 IPC 复杂度与打包适配"
msgstr ""


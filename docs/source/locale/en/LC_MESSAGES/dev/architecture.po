#: ../../source/dev/architecture.md:1 8e6d8271d483452b89c5947f69f25477
msgid "React 组件：项目树、参数面板（schema 自动表单）、Three.js 画布、助手边栏、i18n、图表设置"
msgstr "React components: project tree, parameter panel (schema-driven forms), Three.js canvas, assistant sidebar, i18n, chart settings"

#: ../../source/dev/architecture.md:1 b152446b639141c0978cf4b78796b9ea
msgid "Rust 壳"
msgstr "Rust shell"


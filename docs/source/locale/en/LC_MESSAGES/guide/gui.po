msgid "画布工具栏 + Three.js 画布 + 时间轴"
msgstr "Canvas toolbar + Three.js canvas + timeline"

#: ../../source/guide/gui.md 452f80757a174eeca517db890b6f27e2
msgid "呈现与走查结果"
msgstr "Present and scrub results"

#: ../../source/guide/gui.md 2294b9ba051e42e089238e1f9f636a62
msgid "助手边栏"
msgstr "Assistant sidebar"

#: ../../source/guide/gui.md 2cbea777ab204bfaa37b7d9d4159159d
msgid "会话切换器 + 对话流 + 输入区"

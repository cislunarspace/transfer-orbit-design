{
  "additionalProperties": false,
  "description": "轨道保持输入（对齐 algorithm/station_keeping 的 control_orbit 参数）。\n\n字段与算法层业务参数一一对应；运行时参数（spice/kernel_dir/n_workers/\nseed）由 Facade 注入，不进模型。默认值、单位与算法层签名一致。\n\n输入源二选一（ADR 0031）：``input_ephemeris`` 直接给星历，或\n``input_record_id`` 引用库中记录（取其星历段，站保产物记录自动以\n``source_record_id`` 指向该记录，谱系跨进程不断）。",
  "properties": {
    "input_ephemeris": {
      "default": null,
      "description": "标称轨道星历路径或 EphemerisTable；与 input_record_id 二选一",
      "title": "Input Ephemeris"
    },
    "input_record_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "库中记录 id：取其星历段作为标称轨道；站保产物自动指向该记录",
      "title": "Input Record Id"
    },
    "control_mode": {
      "default": 1,
      "description": "控制模式：1=目标点宽松、2=目标点严格、3=特征点、4=目标点宽松+角动量管理、5=目标点严格+角动量管理、6=特征点+角动量管理",
      "maximum": 6,
      "minimum": 1,
      "title": "Control Mode",
      "type": "integer"
    },
    "is_nrho": {
      "default": 0,
      "description": "目标轨道是否 NRHO（1=是）",
      "maximum": 1,
      "minimum": 0,
      "title": "Is Nrho",
      "type": "integer"
    },
    "special_mode": {
      "default": 1,
      "description": "特征点模式：1=Lissajous（ẋ=0）、2=Halo/NRHO（ẋ=0 且 ż=0）",
      "maximum": 2,
      "minimum": 1,
      "title": "Special Mode",
      "type": "integer"
    },
    "control_interval": {
      "default": 30.0,
      "description": "控制时间间隔（天）",
      "exclusiveMinimum": 0.0,
      "title": "Control Interval",
      "type": "number"
    },
    "feedback_arc": {
      "default": 28.0,
      "description": "目标点模式反馈弧段（天）",
      "exclusiveMinimum": 0.0,
      "title": "Feedback Arc",
      "type": "number"
    },
    "special_crossings": {
      "default": 3,
      "description": "特征点目标穿越 x-z 平面次数",
      "minimum": 1,
      "title": "Special Crossings",
      "type": "integer"

      "title": "Real Perturbation"
    },
    "real_dyb": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 9,
          "minItems": 9,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "真实力模型 DYB 系数（9 元素）：元素 1=等效面质比（m²/kg），其余为相对比值",
      "title": "Real Dyb"
    },
    "real_earth_degree": {
      "default": 10,
      "description": "地球引力场阶数（真实力模型）",
      "maximum": 120,
      "minimum": 2,
      "title": "Real Earth Degree",
      "type": "integer"
    },
    "real_moon_degree": {
      "default": 10,
      "description": "月球引力场阶数（真实力模型）",
      "maximum": 120,
      "minimum": 2,
      "title": "Real Moon Degree",
      "type": "integer"
    },
    "engine_layout": {
      "default": null,
      "description": "EngineLayout（角动量管理 4-6 必填）",
      "title": "Engine Layout"
    },
    "momentum_interval": {
      "default": 5.0,

/* Transfer Orbit Design — 亮色主题
 *
 * 设计语言：
 * - accent 蓝 #0078d4（hover #106ebe / pressed #005a9e），全应用统一
 * - 圆角：输入控件 4px，卡片 6px
 * - 只对容器控件设背景；QLabel 等保持透明，透出父级背景
 */

/* ── 基础 ─────────────────────────────────────────────── */
QMainWindow, QDialog {
    background-color: #f5f5f5;
}
QWidget {
    background-color: #f5f5f5;
    color: #333333;
}
/* 卡片后代控件透明，透出卡片自身背景 */
JobCard QWidget, BatchSummaryCard QWidget {
    background-color: transparent;
}

/* ── 按钮 ─────────────────────────────────────────────── */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cfcfcf;
    border-radius: 4px;
    padding: 5px 14px;
}
QPushButton:hover {
    background-color: #f0f6fc;
    border-color: #0078d4;
}
QPushButton:pressed {
    background-color: #d6e9fa;
}
QPushButton:disabled {
    background-color: #f0f0f0;
    color: #999999;
    border-color: #e0e0e0;
}

/* ── 输入控件 ─────────────────────────────────────────── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #cfcfcf;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #0078d4;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cfcfcf;
    selection-background-color: #d6e9fa;
    selection-color: #333333;
}

/* ── 文本编辑 ─────────────────────────────────────────── */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cfcfcf;
    border-radius: 4px;
}

/* ── 树 / 表头 ────────────────────────────────────────── */
QTreeWidget, QTreeView, QListWidget {
    background-color: #ffffff;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
}
QTreeWidget::item, QTreeView::item {
    padding: 2px 4px;
}
QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: #f0f6fc;
}
QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #d6e9fa;
    color: #1a1a1a;
}
QHeaderView::section {
    background-color: #f0f0f0;
    border: none;
    border-bottom: 1px solid #d8d8d8;
    padding: 4px 8px;
}

/* ── Tab ──────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    background-color: #f5f5f5;
}
QTabBar::tab {
    background-color: transparent;
    color: #666666;
    padding: 6px 14px;
    border: 1px solid transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:hover {
    color: #333333;
    background-color: #e8e8e8;
}
QTabBar::tab:selected {
    background-color: #f5f5f5;
    color: #0078d4;
    border-color: #d8d8d8;
}

/* ── 滚动区域与滚动条 ─────────────────────────────────── */
QScrollArea {
    background-color: #f5f5f5;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #a6a6a6;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #c0c0c0;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #a6a6a6;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ── 分割条 ───────────────────────────────────────────── */
QSplitter::handle {
    background-color: #e0e0e0;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}
QSplitter::handle:hover {
    background-color: #0078d4;
}

/* ── 工具栏 / 状态栏 ──────────────────────────────────── */
QToolBar {
    background-color: #ececec;
    border: none;
    border-bottom: 1px solid #d8d8d8;
    spacing: 6px;
    padding: 4px;
}
QStatusBar {
    background-color: #ececec;
    border-top: 1px solid #d8d8d8;
}

/* ── 菜单 / 工具提示 ──────────────────────────────────── */
QMenu {
    background-color: #ffffff;
    border: 1px solid #cfcfcf;
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: #d6e9fa;
}
QToolTip {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #c0c0c0;
    padding: 4px 8px;
}

/* ── 复选框（含可勾选 QGroupBox 的 indicator） ────────── */
QCheckBox {
    spacing: 6px;
}
QCheckBox::indicator, QGroupBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #8a8a8a;
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:hover, QGroupBox::indicator:hover {
    border-color: #0078d4;
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

/* ── 分组框 ───────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #666666;
}

/* ── 进度条 ───────────────────────────────────────────── */
QProgressBar {
    background-color: #e0e0e0;
    border: none;
    border-radius: 3px;
}
QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 3px;
}

/* ── 任务卡片（JobCard / BatchSummaryCard） ───────────── */
JobCard, BatchSummaryCard {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
}
JobCard:hover, BatchSummaryCard:hover {
    border-color: #0078d4;
}
JobCard QToolButton {
    background: transparent;
    color: #d13438;
    border: none;
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 12px;
}
JobCard QToolButton:hover {
    background-color: rgba(209, 52, 56, 0.10);
}

/* ── 参数 chip 按钮（按 chipSelected 属性区分选中态） ── */
QPushButton[chipSelected="true"] {
    background-color: #0078d4;
    color: #ffffff;
    border: 1px solid #0078d4;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QPushButton[chipSelected="true"]:hover {
    background-color: #106ebe;
    border-color: #106ebe;
}
QPushButton[chipSelected="false"] {
    background-color: transparent;
    color: #555555;
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    padding: 4px 12px;
}
QPushButton[chipSelected="false"]:hover {
    color: #0078d4;
    border-color: #0078d4;
}

/* ── 具名控件 ─────────────────────────────────────────── */
#sidebarEmptyLabel {
    background-color: rgba(255, 255, 255, 0.95);
    color: #888888;
    padding: 20px;
}
#scriptDescLabel {
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 4px;
    color: #444444;
    background-color: #f0f0f0;
}

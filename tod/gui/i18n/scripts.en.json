      "--raw-data-dir": { "label": "Raw Data Directory", "help": "Raw XLSX data directory for auto-import." },
      "--no-auto-build-catalog": { "label": "Disable Auto Import", "help": "Do not auto-import catalog from raw data when normalized dataset is missing." },
      "--verbose": { "label": "Verbose", "help": "Show detailed iteration process (residuals, convergence progress, etc.)." }
    }
  },
